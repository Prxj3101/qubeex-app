{
  "expo": {
    "name": "QubeEx",
    "slug": "QubeEx",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-white.png",
    "scheme": "qubeex",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/ddd482ff-8e81-4257-bf75-9f320db72d14"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.prxj31.qubeex",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-white-fg.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QubeEx to access your photos to set a profile picture."
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#DA7756"
        }
      ],
      [
        "@g9k/expo-dynamic-app-icon",
        {
          "black": {
            "ios": "./assets/icon-black.png",
            "android": {
              "foregroundImage": "./assets/icon-black-fg.png",
              "backgroundColor": "#000000"
            }
          },
          "white": {
            "ios": "./assets/icon-white.png",
            "android": {
              "foregroundImage": "./assets/icon-white-fg.png",
              "backgroundColor": "#ffffff"
            }
          },
          "transparent": {
            "ios": "./assets/icon-black.png",
            "android": {
              "foregroundImage": "./assets/icon-white-fg.png",
              "backgroundColor": "#ffffff"
            }
          }
        }
      ],
      "expo-image",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow QubeEx to use the microphone to take attendance by voice.",
          "speechRecognitionPermission": "Allow QubeEx to recognise your speech to take attendance by voice.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "ddd482ff-8e81-4257-bf75-9f320db72d14"
      }
    },
    "owner": "prxj31"
  }
}
